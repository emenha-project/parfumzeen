APP_NAME="ZEEN PARFUM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://zeen-parfum.vercel.app

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=info

# --- SUPABASE POSTGRESQL (PRODUCTION ON VERCEL) ---
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=postgres.YOUR_PROJECT_REF
DB_PASSWORD=YOUR_SUPABASE_PASSWORD
DB_SSLMODE=require
# DB_URL=postgresql://postgres.xxx:xxx@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# Vercel Serverless storage settings (uses /tmp)
SESSION_DRIVER=cookie
CACHE_STORE=array
QUEUE_CONNECTION=sync

# PAYMENT SETTINGS
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=

# BANK SETTINGS
BCA_ACCOUNT_NAME="ZEEN PARFUM OFFICIAL"
BCA_ACCOUNT_NUMBER="8271928301"
MANDIRI_ACCOUNT_NAME="ZEEN PARFUM OFFICIAL"
MANDIRI_ACCOUNT_NUMBER="1370019283012"
BNI_ACCOUNT_NAME="ZEEN PARFUM OFFICIAL"
BNI_ACCOUNT_NUMBER="0982341209"
BRI_ACCOUNT_NAME="ZEEN PARFUM OFFICIAL"
BRI_ACCOUNT_NUMBER="020601002345501"

